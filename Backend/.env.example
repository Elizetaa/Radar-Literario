APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=radar_literario
DB_USER=radar_app
DB_PASSWORD=defina_localmente
DB_MAX_OPEN=20
DB_MAX_IDLE=5
DB_CONN_MAX_LIFETIME=5m
DB_TIMEOUT=5s
# Gere 32 bytes aleatórios em base64; exemplo de comando no README.
OUTBOX_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=radar_session
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=168h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PASSWORD_RESET_TTL=30m
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_FROM=nao-responda@example.test
PUBLIC_FRONTEND_URL=http://localhost:5173
REQUEST_TIMEOUT=15s
MAX_BODY_BYTES=1048576
AUTH_RATE_LIMIT=30
RANKING_MINIMUM_REVIEWS=1
COMMENT_MAX_DEPTH=5
CONTENT_BLOCKED_TERMS=
CONTENT_BLOCKED_DOMAINS=
RETENTION_DAYS=180
